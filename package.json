{
  "devDependencies": {
    "cypress": "^16.1.1"
  },
  "allowScripts": {
    "cypress": true
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "cy:record": "cypress run --browser chrome --record --key 9806abcd-0829-4fe5-b3d0-bb38a7d0eb34",
    "cy:record:parallel": "cypress run --parallel --browser chrome --record --key 9806abcd-0829-4fe5-b3d0-bb38a7d0eb34"
  }
}
