{
  "devDependencies": {
    "@types/node": "^24.19.1",
    "cypress": "^16.1.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "cypress": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cy:open": "cypress open --browser chrome",
    "cy:run": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "cy:record": "cypress run --browser chrome --record --key $CYPRESS_RECORD_KEY",
    "cy:parallel": "cypress run --browser chrome --record --key $CYPRESS_RECORD_KEY --parallel",
    "start": "my-server -p 4200",
    "test": "start-server-and-test start http://localhost:4200 cy:run"
  }
}