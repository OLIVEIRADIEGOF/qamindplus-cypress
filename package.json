{
  "devDependencies": {
    "cypress": "^16.1.1",
    "typescript": "^7.0.2",
    "@types/node": "^24.19.1"
  },
  "allowScripts": {
    "cypress": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "cy:record": "cypress run --browser chrome --record",
    "cy:record:parallel": "cypress run --parallel --browser chrome --record"
  }
}
